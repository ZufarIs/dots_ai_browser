# Provider config for `dots`.
#
# A `.env` beside the command is read first; whatever is not already set in
# the shell is taken from here. Copy this file to `.env`, fill in the values
# for the service you use, and run `dots` from this directory.
#
# Precedence: --flag > the shell > this file > the default.
#
# Without `OPENAI_BASE_URL` set, `dots` keeps talking to OpenRouter exactly
# as it always has: an OpenRouter key in `OPENAI_API_KEY` (or the legacy
# `OPENROUTER_API_KEY`, or `--openrouter-key`) is enough.

# --- OpenAI-compatible provider ---------------------------------------------
#
# Any endpoint that speaks the OpenAI Chat Completions API: OpenAI, Azure
# OpenAI, Together, Groq, OpenRouter, a local llama.cpp / Ollama / vLLM
# server, or anything else pointed at one of those.

# The credential the OpenAI SDK names first. Mirrored into OPENROUTER_API_KEY
# automatically so the package that ships under this interface still finds it.
OPENAI_API_KEY=

# The endpoint. No trailing slash. Example values:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   http://127.0.0.1:11434/v1     (Ollama)
#   http://127.0.0.1:8080/v1       (llama.cpp server)
OPENAI_BASE_URL=

# The model id as the provider names it. Mirrored into INVISIBLE_MCP_MODEL.
OPENAI_MODEL=

# --- Profile ------------------------------------------------------------------
#
# A profile is a NAME for a bundle that always belongs together: a browser
# directory (cookies, logins, the seed), a working folder, a proxy and a
# fingerprint. Make one with `dots profile add work`, then name it here and
# every run in this directory comes up as that person.
#
# The same as the `--profile work` flag, and lower priority than it: a
# `--profile-dir` written out by hand still wins, the way `--flag` beats
# `.env` everywhere else in this file.
#
# The profiles themselves, and the logins saved against them, live under
# <HOME>/invisible-playwright-mcp/profiles/ - not here. `dots profile list`
# shows what exists; `dots auth list NAME` shows the logins, without the
# passwords.
DOTS_PROFILE=